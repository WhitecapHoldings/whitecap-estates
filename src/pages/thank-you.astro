---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You" description="We received your property details and will be in touch within one business day.">

  <section style="padding: 120px 24px; text-align: center;">
    <div class="container" style="max-width: 560px;">
      <div class="check-circle">✓</div>
      <h1>We Got It.</h1>
      <p style="font-size: 1.1rem; margin-top: 16px;">Thanks for submitting your property details. We'll review everything and follow up within one business day.</p>
      <p>If you'd rather talk now, call or text us directly:</p>
      <div class="thank-you-phones">
        <a href="tel:4693585646">Kyle: (469) 358-5646</a>
        <a href="tel:9453499179">Cristian: (945) 349-9179</a>
      </div>
      <a href="/" class="btn btn-primary" style="margin-top: 32px; display: inline-block;">Back to Home</a>
    </div>
  </section>

</Layout>

<style>
.check-circle {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--accent);
  color: var(--navy-dark);
  font-size: 1.8rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24px;
}

.thank-you-phones {
  display: flex;
  gap: 24px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 12px;
}

.thank-you-phones a {
  font-weight: 600;
  color: var(--navy);
  font-size: 1rem;
}
</style>
